
# FILE: .env.example
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git — it contains secrets.
# 

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME=Travello AI
APP_VERSION=1.0.0
DEBUG=False

# ── Supabase 
# Your project URL (e.g. https://abcdefghijkl.supabase.co)
SUPABASE_URL=https://your-project-ref.supabase.co

# Anon / public key — safe to expose in client apps
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role key — KEEP SECRET. Bypasses all RLS policies.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# JWT Secret — used to verify user tokens sent from Flutter app.
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# ── AviationStack Flight Data (optional — free tier: 100 req/month) ───────────
# Sign up at: https://aviationstack.com
# Copy the API Access Key from your dashboard.
# Leave blank to use built-in Pakistan mock data (no quota used).
AVIATIONSTACK_KEY=your-aviationstack-api-key-here

# ── RapidAPI Hotel Search (free tier) ─────────────────────────────────────────
# Sign up at: https://rapidapi.com
# Subscribe to "Hotels4" API (free tier: 500 req/month)
# Key found in: RapidAPI Dashboard → Apps → Default Application → Authorization
RAPIDAPI_KEY=your-rapidapi-key-here
RAPIDAPI_HOST=tripadvisor-com1.p.rapidapi.com

# ── Email — Gmail SMTP ────────────────────────────────────────────────────────
# 1. Enable 2-Step Verification: https://myaccount.google.com/security
# 2. Create App Password: Google Account → Security → App Passwords → Mail
# 3. Fill in below (use the 16-char App Password, NOT your Gmail password)
SMTP_USER=your-gmail@gmail.com
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
EMAIL_REPLY_TO=support@travello.ai

# ── Currency Conversion (fixed rates — no live API needed) ────────────────────
# Update these manually when rates shift significantly
USD_TO_PKR_RATE=278.0
EUR_TO_PKR_RATE=305.0

# ── OTP Settings ─────────────────────────────────────────────────────────────
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=3

# ── Google Places API (for Healthcare nearby search) ─────────────────────────
# Google Cloud Console → APIs & Services → Credentials → Create API Key
# Enable: Places API
GOOGLE_PLACES_API_KEY=your-google-places-api-key-here

# ── AI / LLM — Groq (primary) + Gemini (fallback) ─────────────────────────────
# The AI travel assistant uses Groq as the primary LLM and Gemini as fallback.
# Groq (free, no billing): https://console.groq.com → API Keys
GROQ_API_KEY=your-groq-api-key-here

GROQ_MODEL=llama-3.3-70b-versatile
# OpenRouter (fallback when Groq is rate-limited): free key at https://openrouter.ai

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b:free,nvidia/nemotron-3-super-120b-a12b:free

GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# ── CORS 
CORS_ORIGINS=*
