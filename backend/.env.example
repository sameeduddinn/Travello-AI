# =============================================================================
# FILE: .env.example
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git — it contains secrets.
# =============================================================================

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME=Travello AI
APP_VERSION=1.0.0
DEBUG=False

# ── Supabase ──────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API

# Your project URL (e.g. https://abcdefghijkl.supabase.co)
SUPABASE_URL=https://your-project-ref.supabase.co

# Anon / public key — safe to expose in client apps
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role key — KEEP SECRET. Bypasses all RLS policies.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# JWT Secret — used to verify user tokens sent from Flutter app.
# Found in: Supabase Dashboard → Project Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# Direct PostgreSQL connection (for asyncpg pool — optional for FYP demo)
# Found in: Supabase Dashboard → Project Settings → Database → Connection String
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# For Render.com: use the "Transaction" connection pooler URL
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# ── AviationStack Flight Data (optional — free tier: 100 req/month) ───────────
# Sign up at: https://aviationstack.com
# Copy the API Access Key from your dashboard.
# Leave blank to use built-in Pakistan mock data (no quota used).
AVIATIONSTACK_KEY=your-aviationstack-api-key-here

# ── RapidAPI Hotel Search (free tier) ─────────────────────────────────────────
# Sign up at: https://rapidapi.com
# Subscribe to "Hotels4" API (free tier: 500 req/month)
# Key found in: RapidAPI Dashboard → Apps → Default Application → Authorization
RAPIDAPI_KEY=your-rapidapi-key-here
RAPIDAPI_HOST=tripadvisor-com1.p.rapidapi.com

# ── Resend Email (free tier — no domain verification needed for demo) ──────────
# Sign up at: https://resend.com
# Create an API key at: Resend Dashboard → API Keys → Create API Key
# Free tier: 100 emails/day, 3,000/month
# Use onboarding@resend.dev as sender — works without domain verification
RESEND_API_KEY=re_your-resend-api-key-here

# Sender shown in the "From" field — onboarding@resend.dev works on free tier
EMAIL_FROM=Travello AI <onboarding@resend.dev>

# Reply-to address shown to email recipients
EMAIL_REPLY_TO=support@travello.ai

# ── Currency Conversion (fixed rates — no live API needed) ────────────────────
# Update these manually when rates shift significantly
USD_TO_PKR_RATE=278.0
EUR_TO_PKR_RATE=305.0

# ── OTP Settings ─────────────────────────────────────────────────────────────
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=3

# ── CORS ─────────────────────────────────────────────────────────────────────
# Use "*" during development (Flutter on phone / emulator)
# In production, restrict to your Flutter app's origin if using web
CORS_ORIGINS=*
